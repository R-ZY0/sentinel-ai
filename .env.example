# Application
APP_NAME=sentinel-ai
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Local target behavior: protected or demo_vulnerable
LOCAL_TARGET_MODE=protected


# Generate a random signing key before starting the API
JWT_SECRET_KEY=


# week1: original scan flow; week2: baseline judges and security validation
SENTINEL_PIPELINE=week2