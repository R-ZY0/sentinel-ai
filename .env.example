# Application
APP_NAME=sentinel-ai
ENVIRONMENT=development

# PostgreSQL
POSTGRES_DB=sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Local target behavior: protected or demo_vulnerable
LOCAL_TARGET_MODE=protected


# Generate a random signing key before starting the API
JWT_SECRET_KEY=


# week1: original scan flow; week2: baseline judges and security validation
SENTINEL_PIPELINE=week2

# Real tool executions, sequentially evaluated and persisted by the worker.
# Optional: library,pyrit,garak. Tool services always use protected mode.
WEEK2_ATTACK_ENGINES=pyrit,garak

# Exact approved target base URLs or REST endpoint URLs, comma-separated.
# Validation never follows redirects or uses environment proxies.
TARGET_ALLOWED_ENDPOINTS=http://ollama:11434

# Required for week34 scans: server-managed random key, at least 64 hexadecimal characters.
# Generate once and retain it to verify existing receipts. Never commit the real key.
EVIDENCE_AUDIT_KEY=
WEEK34_TARGET_MODE=protected
